+    # ------------------------------------------------------------------
+    # FACA loss.
+    # ------------------------------------------------------------------
+    def _faca_loss(self, device):
+        if (
+            not self.use_faca
+            or self.fuser is None
+            or self.current_epoch < self.faca_warmup_epochs
+            or len(self.feasible_unseen) == 0
+        ):
+            return torch.zeros((), device=device)
+
+        import random
+        # Try up to a multiple of n_synth_per_batch to fill, in case bank misses.
+        target_n = self.n_synth_per_batch
+        max_tries = target_n * 4
+        chosen = []
+        for _ in range(max_tries):
+            if len(chosen) >= target_n:
+                break
+            a, o, w = random.choice(self.feasible_unseen)
+            if not (self.bank_attr.has(a) and self.bank_obj.has(o)):
+                continue
+            chosen.append((a, o, w))
+        if len(chosen) == 0:
+            return torch.zeros((), device=device)
+
+        f_a_list = [self.bank_attr.sample(a) for (a, o, _w) in chosen]
+        f_o_list = [self.bank_obj.sample(o) for (a, o, _w) in chosen]
+        f_a_stack = torch.stack(f_a_list, dim=0).to(device, non_blocking=True)
+        f_o_stack = torch.stack(f_o_list, dim=0).to(device, non_blocking=True)
+        f_a_stack = f_a_stack.to(self.fuser.net[0].weight.dtype)
+        f_o_stack = f_o_stack.to(self.fuser.net[0].weight.dtype)
+
+        weights = torch.tensor([c[2] for c in chosen], device=device, dtype=f_a_stack.dtype)
+
+        # Compose to a synthetic compositional rep.
+        f_c_syn = self.fuser(f_a_stack, f_o_stack)
+        f_c_syn = F.normalize(f_c_syn, p=2, dim=-1)
+
+        # Prompt rep for each synthetic pair.
+        pair_idx = torch.tensor([(a, o) for (a, o, _w) in chosen], device=device, dtype=torch.long)
+        token_com, _, _ = self.csp.construct_token_tensors(pair_idx)
+        # Only need the composition prompt branch.
+        t_c_syn = self.text_encoder(self.csp.token_ids[0], token_com, enable_pos_emb=True)
+        t_c_syn = F.normalize(t_c_syn, p=2, dim=-1)
+
+        logits = self.temp_logit * f_c_syn @ t_c_syn.T
+        targets = torch.arange(len(chosen), device=device)
+        ce = F.cross_entropy(logits, targets, reduction="none")
+        return (ce * weights).mean()
